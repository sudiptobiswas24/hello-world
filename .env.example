# Database
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/pp_erp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="pp-erp"

# API
API_PORT="3001"
API_HOST="0.0.0.0"
NODE_ENV="development"

# Frontend
VITE_API_URL="http://localhost:3001/api/v1"

# Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@pp-erp.local"

# SMS (MSG91)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""

# E-way Bill (NIC API)
EWAY_BILL_USERNAME=""
EWAY_BILL_PASSWORD=""
EWAY_BILL_GSTIN=""
