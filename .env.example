# Copy to .env on the server and fill in. Never commit the filled-in copy.

# Generate each with:  openssl rand -hex 32
# (hex only: the password goes into a URL, where other characters break it)
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# What people type to reach it. A public domain gets a certificate by
# itself; a plant-network name or address needs ERP_TLS=tls internal.
ERP_SITE=erp.example.in
ERP_TLS=

# The same host name(s), comma-separated; and with https:// in front.
DJANGO_ALLOWED_HOSTS=erp.example.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.in

# Shifts, dates and the nightly backup run on this clock.
DJANGO_TIME_ZONE=Asia/Kolkata

# false only for plain HTTP on the plant's own network. See RUNBOOK.md.
DJANGO_HTTPS=true

BACKUP_AT=02:00
BACKUP_KEEP_DAYS=30

# Leave EMAIL_HOST empty and nothing is emailed; see RUNBOOK.md, "Email".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Who is mailed when a request fails on the server (comma-separated).
# Needs EMAIL_HOST above. See RUNBOOK.md, "When something goes wrong".
DJANGO_ADMINS=
